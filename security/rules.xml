<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_cancel_request_own" model="ir.rule">
            <field name="name">Invoice cancellation requests requested by user</field>
            <field name="model_id" ref="model_dex_invoice_cancel_request"/>
            <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_invoice_cancel_requester'))]"/>
        </record>
        <record id="rule_cancel_request_approver_all" model="ir.rule">
            <field name="name">Invoice cancellation approvers see all requests</field>
            <field name="model_id" ref="model_dex_invoice_cancel_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_invoice_cancel_approver'))]"/>
        </record>
        <record id="rule_update_request_own" model="ir.rule">
            <field name="name">Invoice update requests requested by user</field>
            <field name="model_id" ref="model_dex_invoice_update_request"/>
            <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_invoice_update_requester'))]"/>
        </record>
        <record id="rule_update_request_approver_all" model="ir.rule">
            <field name="name">Invoice update approvers see all requests</field>
            <field name="model_id" ref="model_dex_invoice_update_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_invoice_update_approver'))]"/>
        </record>
        <record id="rule_update_request_line_own" model="ir.rule">
            <field name="name">Invoice update request lines requested by user</field>
            <field name="model_id" ref="model_dex_invoice_update_request_line"/>
            <field name="domain_force">[('request_id.requested_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_invoice_update_requester'))]"/>
        </record>
        <record id="rule_update_request_line_approver_all" model="ir.rule">
            <field name="name">Invoice update approvers see all request lines</field>
            <field name="model_id" ref="model_dex_invoice_update_request_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_invoice_update_approver'))]"/>
        </record>
    </data>
    <data>
        <record id="rule_cancel_request_internal_own" model="ir.rule">
            <field name="name">Invoice users see their own cancellation requests</field>
            <field name="model_id" ref="model_dex_invoice_cancel_request"/>
            <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
