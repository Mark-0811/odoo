<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_update_request_wizard_form" model="ir.ui.view">
            <field name="name">dex.invoice.update.request.wizard.form</field>
            <field name="model">dex.invoice.update.request.wizard</field>
            <field name="arch" type="xml">
                <form string="Request Invoice Update">
                    <group>
                        <field name="invoice_state" invisible="1"/>
                        <group>
                            <field name="invoice_id"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group string="Posted Invoice Date Change"
                               attrs="{'invisible':[('invoice_state','!=','posted')]}">
                            <field name="current_invoice_date"/>
                            <field name="change_invoice_date" invisible="1"/>
                            <field name="requested_invoice_date"
                                   attrs="{'required':[('invoice_state','=','posted')]}"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1"
                           attrs="{'invisible':[('invoice_state','!=','draft')]}">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="invoice_line_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="current_quantity"/>
                            <field name="product_uom_id"/>
                            <field name="change_type"/>
                            <field name="new_quantity"
                                   attrs="{'readonly':[('change_type','!=','reduce')],'required':[('change_type','=','reduce')]}"/>
                        </tree>
                    </field>
                    <group>
                        <field name="justification" required="1"
                               placeholder="Explain why these changes are required"/>
                    </group>
                    <footer>
                        <button name="action_submit" type="object" string="Submit Request" class="btn-primary"/>
                        <button string="Discard" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
