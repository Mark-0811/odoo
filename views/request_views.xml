<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_invoice_cancel_request_tree" model="ir.ui.view">
            <field name="name">dex.invoice.cancel.request.tree</field>
            <field name="model">dex.invoice.cancel.request</field>
            <field name="arch" type="xml">
                <tree create="0" delete="0">
                    <field name="name"/>
                    <field name="requested_date"/>
                    <field name="invoice_id"/>
                    <field name="sale_order_id"/>
                    <field name="partner_id"/>
                    <field name="reason_id"/>
                    <field name="requested_by_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_invoice_cancel_request_form" model="ir.ui.view">
            <field name="name">dex.invoice.cancel.request.form</field>
            <field name="model">dex.invoice.cancel.request</field>
            <field name="arch" type="xml">
                <form string="Invoice Cancellation Request" create="0" delete="0">
                    <header>
                        <button name="action_approve" type="object" string="Approve"
                                class="btn-primary"
                                groups="dex_invoice_cancel.group_invoice_cancel_approver"
                                attrs="{'invisible':[('state','!=','requested')]}"
                                confirm="Approve this request and post a full credit memo?"/>
                        <button name="action_reject" type="object" string="Reject"
                                groups="dex_invoice_cancel.group_invoice_cancel_approver"
                                attrs="{'invisible':[('state','!=','requested')]}"
                                confirm="Reject this request?"/>
                        <field name="state" widget="statusbar" statusbar_visible="requested,approved,rejected"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name"/></h1></div>
                        <group>
                            <group>
                                <field name="invoice_id"/>
                                <field name="sale_order_id"/>
                                <field name="partner_id"/>
                                <field name="reason_id"/>
                                <field name="credit_move_id" attrs="{'invisible':[('credit_move_id','=',False)]}"/>
                            </group>
                            <group>
                                <field name="amount_total"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="requested_by_id"/>
                                <field name="requested_date"/>
                                <field name="decided_by_id" attrs="{'invisible':[('decided_by_id','=',False)]}"/>
                                <field name="decided_date" attrs="{'invisible':[('decided_date','=',False)]}"/>
                                <field name="request_mail_sent"/>
                            </group>
                        </group>
                        <group>
                            <field name="justification"/>
                            <field name="decision_remarks"
                                   groups="dex_invoice_cancel.group_invoice_cancel_approver"
                                   attrs="{'readonly':[('state','!=','requested')]}"
                                   placeholder="Required when rejecting"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_invoice_cancel_requests" model="ir.actions.act_window">
            <field name="name">Invoice Cancellation Requests</field>
            <field name="res_model">dex.invoice.cancel.request</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': 0}</field>
        </record>

        <record id="view_invoice_update_request_tree" model="ir.ui.view">
            <field name="name">dex.invoice.update.request.tree</field>
            <field name="model">dex.invoice.update.request</field>
            <field name="arch" type="xml">
                <tree create="0" delete="0">
                    <field name="name"/>
                    <field name="requested_date"/>
                    <field name="invoice_id"/>
                    <field name="sale_order_id"/>
                    <field name="partner_id"/>
                    <field name="requested_by_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_invoice_update_request_form" model="ir.ui.view">
            <field name="name">dex.invoice.update.request.form</field>
            <field name="model">dex.invoice.update.request</field>
            <field name="arch" type="xml">
                <form string="Invoice Update Request" create="0" delete="0">
                    <header>
                        <button name="action_approve" type="object" string="Approve"
                                class="btn-primary"
                                groups="dex_invoice_cancel.group_invoice_update_approver"
                                attrs="{'invisible':[('state','!=','requested')]}"
                                confirm="Apply these exact changes to the draft invoice?"/>
                        <button name="action_reject" type="object" string="Reject"
                                groups="dex_invoice_cancel.group_invoice_update_approver"
                                attrs="{'invisible':[('state','!=','requested')]}"
                                confirm="Reject this request?"/>
                        <field name="state" widget="statusbar" statusbar_visible="requested,approved,rejected"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name"/></h1></div>
                        <group>
                            <group>
                                <field name="invoice_id"/>
                                <field name="sale_order_id"/>
                                <field name="partner_id"/>
                                <field name="amount_total"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="requested_by_id"/>
                                <field name="requested_date"/>
                                <field name="decided_by_id" attrs="{'invisible':[('decided_by_id','=',False)]}"/>
                                <field name="decided_date" attrs="{'invisible':[('decided_date','=',False)]}"/>
                                <field name="request_mail_sent"/>
                            </group>
                        </group>
                        <group string="Invoice Date">
                            <field name="change_invoice_date"/>
                            <field name="original_invoice_date" attrs="{'invisible':[('change_invoice_date','=',False)]}"/>
                            <field name="requested_invoice_date" attrs="{'invisible':[('change_invoice_date','=',False)]}"/>
                        </group>
                        <notebook>
                            <page string="Requested Line Changes">
                                <field name="line_ids" nolabel="1">
                                    <tree create="0" edit="0" delete="0">
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="original_quantity"/>
                                        <field name="product_uom_id"/>
                                        <field name="original_price_unit"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="original_discount"/>
                                        <field name="tax_ids" widget="many2many_tags"/>
                                        <field name="change_type"/>
                                        <field name="target_quantity"
                                               attrs="{'invisible':[('change_type','!=','reduce')]}"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <field name="justification"/>
                            <field name="decision_remarks"
                                   groups="dex_invoice_cancel.group_invoice_update_approver"
                                   attrs="{'readonly':[('state','!=','requested')]}"
                                   placeholder="Required when rejecting"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_invoice_update_requests" model="ir.actions.act_window">
            <field name="name">Invoice Update Requests</field>
            <field name="res_model">dex.invoice.update.request</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': 0}</field>
        </record>

        <menuitem id="menu_invoice_cancel_requests"
                  name="Invoice Cancellation Requests"
                  parent="account.menu_finance_receivables"
                  action="action_invoice_cancel_requests"
                  groups="dex_invoice_cancel.group_invoice_cancel_requester,dex_invoice_cancel.group_invoice_cancel_approver"
                  sequence="80"/>
        <menuitem id="menu_invoice_update_requests"
                  name="Invoice Update Requests"
                  parent="account.menu_finance_receivables"
                  action="action_invoice_update_requests"
                  groups="dex_invoice_cancel.group_invoice_update_requester,dex_invoice_cancel.group_invoice_update_approver"
                  sequence="81"/>
    </data>
</odoo>
