<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_invoice_request_approvers" model="ir.ui.view">
            <field name="name">res.config.settings.form.invoice.request.approvers</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='invoicing_settings']" position="after">
                    <h2 groups="base.group_system">Invoice Request Approval</h2>
                    <div class="row mt16 o_settings_container"
                         id="dex_invoice_request_approvers"
                         groups="base.group_system">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="dex_cancel_request_approver_ids"/>
                                <div class="text-muted">
                                    Users authorized to approve cancellation requests and receive their emails.
                                </div>
                                <div class="content-group mt16">
                                    <field name="dex_cancel_request_approver_ids"
                                           widget="many2many_tags"
                                           domain="[('active', '=', True), ('share', '=', False)]"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="dex_update_request_approver_ids"/>
                                <div class="text-muted">
                                    Users authorized to approve invoice update requests and receive their emails.
                                </div>
                                <div class="content-group mt16">
                                    <field name="dex_update_request_approver_ids"
                                           widget="many2many_tags"
                                           domain="[('active', '=', True), ('share', '=', False)]"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
